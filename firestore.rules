rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aturan untuk Komunitas Voting VanzMusic (Realtime antar pengguna di Vercel/Hosting)
    match /community_votes/{voteId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Aturan untuk Pesan Resmi Admin
    match /official_messages/{messageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
